---
import SocialLinks from './SocialLinks.astro';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;

const copy = {
  es: {
    badge: 'Comunidad',
    title: 'Únete a nuestra comunidad',
    subtitle:
      'Síguenos y entérate de sorteos, directos y novedades antes que nadie.',
  },
  en: {
    badge: 'Community',
    title: 'Join our community',
    subtitle: 'Follow us and get giveaways, live streams and news first.',
  },
}[lang];
---

<section class="mx-auto mb-16 w-full max-w-[800px] text-center">
  <div class="flex flex-col items-center gap-4 pb-8">
    <span class="inline-flex items-center gap-1.5 rounded-full border border-[rgba(167,139,250,0.35)] bg-[rgba(167,139,250,0.12)] px-3 py-1 text-xs font-semibold text-[#c4b5fd]">
      <span aria-hidden="true" class="text-[0.95em] leading-none align-middle">🌐</span>
      {copy.badge}
    </span>
    <h2 class="text-[clamp(1.6rem,3.5vw,2.2rem)] font-extrabold leading-[1.15] tracking-[-0.03em]">
      {copy.title}
    </h2>
    <p class="max-w-[52ch] text-[1rem] text-muted">{copy.subtitle}</p>
  </div>
  <div class="flex justify-center">
    <SocialLinks lang={lang} variant="large" />
  </div>
</section>