---
interface Props {
  currentLang: 'es' | 'en';
}

const { currentLang } = Astro.props;
const targetPath = currentLang === 'es' ? '/en/' : '/';
---

<a
  class="inline-flex items-center gap-1.5 rounded-full border border-border px-3.5 py-1.5 text-sm font-bold text-muted transition duration-150 hover:border-accent hover:text-ink"
  href={targetPath}
  aria-label="Switch language"
>
  <span class={currentLang === 'es' ? 'text-primary' : ''}>ES</span>
  <span class="text-border">|</span>
  <span class={currentLang === 'en' ? 'text-primary' : ''}>EN</span>
</a>