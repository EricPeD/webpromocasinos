---
import LanguageToggle from './LanguageToggle.astro';
import SocialLinks from './SocialLinks.astro';

interface Props {
  currentLang: 'es' | 'en';
}

const { currentLang } = Astro.props;
const brandName = currentLang === 'es' ? 'Mejores casinos' : 'Best casinos';
---

<header class="sticky top-0 z-[100] border-b border-border bg-[rgba(15,18,32,0.8)] backdrop-blur-xl">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-5 py-4">
    <a href={currentLang === 'es' ? '/' : '/en/'} class="inline-flex items-center gap-2.5">
      <span class="text-[1.25rem] leading-none align-middle">🎰</span>
      <span class="bg-gradient-to-r from-primary to-accent bg-clip-text text-[1.15rem] font-extrabold tracking-tight text-transparent">
        {brandName}
      </span>
    </a>
    <div class="flex items-center gap-3">
      <SocialLinks lang={currentLang} variant="compact" />
      <LanguageToggle currentLang={currentLang} />
    </div>
  </div>
</header>