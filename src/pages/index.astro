---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CasinoCard from '../components/CasinoCard.astro';
import CommunitySection from '../components/CommunitySection.astro';
import { casinos } from '../data/casinos';

const lang = 'es';
const title = 'Mejores casinos online 2026 | Bonos de bienvenida exclusivos';
const description =
  'Descubre los mejores casinos online con bonos de bienvenida exclusivos. Juega con responsabilidad.';
---

<Layout title={title} description={description} lang={lang} path="/">
  <Header currentLang={lang} />

  <main class="mx-auto w-full max-w-5xl flex-1 px-5 py-12">
    <section class="flex flex-col items-center gap-4 px-0 pb-12 pt-6 text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-[rgba(167,139,250,0.35)] bg-[rgba(167,139,250,0.12)] px-3 py-1 text-xs font-semibold text-[#c4b5fd]">
        <span aria-hidden="true" class="text-[0.95em] leading-none align-middle">🔥</span>
        Ofertas 2026
      </span>
      <h1 class="max-w-[24ch] text-[clamp(2rem,5vw,3.2rem)] font-extrabold leading-[1.15] tracking-[-0.03em]">
        Los mejores casinos online con bonos exclusivos
      </h1>
      <p class="max-w-[52ch] text-[1.1rem] text-muted">
        Comparamos los bonos más generosos para que juegues con la máxima ventaja.
      </p>
    </section>

    <CommunitySection lang={lang} />

    <section class="mx-auto grid w-full max-w-[800px] grid-cols-[repeat(auto-fit,minmax(300px,1fr))] items-stretch justify-center gap-6">
      {casinos.map((casino) => (
        <CasinoCard casino={casino} lang={lang} ctaLabel="Jugar ahora" />
      ))}
    </section>

    <div class="mt-14 text-center text-xs leading-[1.7] text-muted">
      18+ Juega con responsabilidad. El juego puede ser adictivo. Este sitio utiliza enlaces de afiliados.
    </div>
  </main>
</Layout>