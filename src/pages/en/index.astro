---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import CasinoCard from '../../components/CasinoCard.astro';
import { casinos } from '../../data/casinos';

const lang = 'en';
const title = 'Best online casinos 2026 | Exclusive welcome bonuses';
const description =
  'Discover the best online casinos with exclusive welcome bonuses. Play responsibly.';
---

<Layout title={title} description={description} lang={lang} path="/en/">
  <Header currentLang={lang} />

  <main class="mx-auto w-full max-w-5xl flex-1 px-5 py-12">
    <section class="flex flex-col items-center gap-4 px-0 pb-12 pt-6 text-center">
      <span class="rounded-full border border-[rgba(167,139,250,0.35)] bg-[rgba(167,139,250,0.12)] px-3 py-1 text-xs font-semibold text-[#c4b5fd]">
        🔥 2026 Offers
      </span>
      <h1 class="max-w-[24ch] text-[clamp(2rem,5vw,3.2rem)] font-extrabold leading-[1.15] tracking-[-0.03em]">
        Best online casinos with exclusive bonuses
      </h1>
      <p class="max-w-[52ch] text-[1.1rem] text-muted">
        We compare the most generous bonuses so you can play with the maximum advantage.
      </p>
    </section>

    <section class="mx-auto grid w-full max-w-[800px] grid-cols-[repeat(auto-fit,minmax(300px,360px))] items-start justify-center gap-6">
      {casinos.map((casino) => (
        <CasinoCard casino={casino} lang={lang} ctaLabel="Play now" />
      ))}
    </section>

    <div class="mt-14 text-center text-xs leading-[1.7] text-muted">
      18+ Play responsibly. Gambling can be addictive. This site uses affiliate links.
    </div>
  </main>
</Layout>